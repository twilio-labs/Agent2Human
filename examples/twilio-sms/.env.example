# Twilio Credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567

# Principal ID to Phone Number mapping
# Format: principalId:phoneNumber,principalId:phoneNumber
# Example: did:example:alice:+15559876543,did:example:bob:+15551112222
USER_PHONE_MAP=did:example:alice:+15559876543

# Server Configuration
PORT=3002
BASE_URL=http://localhost:3002

# For production with ngrok/tunnel:
# BASE_URL=https://your-ngrok-url.ngrok.io
